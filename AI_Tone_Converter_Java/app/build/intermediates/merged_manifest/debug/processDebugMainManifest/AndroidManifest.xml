<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.aitonechanger"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_app_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:roundIcon="@drawable/ic_app_launcher"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/AppTheme" >
        <activity android:name="com.example.aitonechanger.SearchActivity" />
        <activity android:name="com.example.aitonechanger.SettingsActivity" />
        <activity android:name="com.example.aitonechanger.ProfileActivity" />
        <activity
            android:name="com.example.aitonechanger.PromptEditActivity"
            android:theme="@style/AppDialogTheme"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.aitonechanger.PromptCreateActivity"
            android:theme="@style/AppDialogTheme"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.aitonechanger.PromptCreateKeywordActivity"
            android:theme="@style/AppDialogTheme"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.example.aitonechanger.SignupActivity"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name="com.example.aitonechanger.MainActivity"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name="com.example.aitonechanger.LoginActivity"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name="com.example.aitonechanger.SplashActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.example.aitonechanger.ProfileEditActivity" />
        <activity
            android:name="com.example.aitonechanger.PasswordChangeActivity"
            android:windowSoftInputMode="adjustPan" />
    </application>

</manifest>