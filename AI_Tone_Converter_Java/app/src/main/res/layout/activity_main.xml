<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/surface">

        <!-- 상단바: 상태바/펀치홀 클리어는 BaseActivity 인셋으로 처리 -->
        <FrameLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/surface">

            <!-- 왼쪽 햄버거 메뉴 -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="56dp"
                android:layout_gravity="start|bottom"
                android:padding="14dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_menu"
                android:scaleType="center"
                android:contentDescription="메뉴" />

            <!-- 제목: 아이콘 사이가 아니라 화면 전체 기준 가운데 -->
            <TextView
                android:id="@+id/txtHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_gravity="center_horizontal|bottom"
                android:gravity="center"
                android:text="AI 오늘의 말투 변환기"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_main"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- 오른쪽 검색/내정보 아이콘 묶음 -->
            <LinearLayout
                android:layout_width="96dp"
                android:layout_height="56dp"
                android:layout_gravity="end|bottom"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnSearch"
                    android:layout_width="48dp"
                    android:layout_height="56dp"
                    android:padding="14dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_search"
                    android:contentDescription="검색" />

                <ImageButton
                    android:id="@+id/btnProfile"
                    android:layout_width="48dp"
                    android:layout_height="56dp"
                    android:padding="14dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_user"
                    android:contentDescription="내 정보" />

            </LinearLayout>

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <ScrollView
            android:id="@+id/chatScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:background="@color/surface">

            <LinearLayout
                android:id="@+id/chatContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="520dp"
                android:orientation="vertical"
                android:padding="20dp" />

        </ScrollView>

        <!-- 실시간 변환 미리보기 (설정에서 켰을 때, 입력을 멈추면 표시) -->
        <LinearLayout
            android:id="@+id/previewBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@color/surface"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_input"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="미리보기 — 이대로 전송하면 이 결과가 바로 사용돼요"
                    android:textColor="@color/blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/previewText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:maxLines="5"
                    android:ellipsize="end"
                    android:textColor="@color/text_main"
                    android:textSize="14sp" />

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:gravity="center_vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:background="@color/surface">

            <ImageButton
                android:id="@+id/btnInputHistory"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginRight="6dp"
                android:padding="9dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_clock"
                android:contentDescription="최근 입력" />

            <EditText
                android:id="@+id/editMessage"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/rounded_input"
                android:hint="메시지를 입력하세요..."
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textSize="14sp"
                android:singleLine="true" />

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginLeft="8dp"
                android:padding="12dp"
                android:background="@drawable/circle_blue"
                android:src="@drawable/ic_send"
                android:contentDescription="전송" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/sidebarDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="318dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/sidebar_bg"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="34dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/rounded_icon_blue_light">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_message_square" />

            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:text="AI 오늘의 말투 변환기"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text_main" />

            <ImageButton
                android:id="@+id/btnCloseSidebar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="10dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:contentDescription="닫기" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/sidebarSearch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:background="@drawable/rounded_input">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_search"
                android:alpha="0.45" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="검색"
                android:textColor="@color/text_sub"
                android:textSize="18sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnNewPrompt"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:background="@drawable/rounded_primary"
            android:text="+  새 프롬프트 생성"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="20dp"
            android:clipToPadding="false"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/promptListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

    </LinearLayout>

</FrameLayout>